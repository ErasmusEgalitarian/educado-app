{
  "name": "educado-app",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "license": "Apache-2.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "eas:development": "eas build --profile development --platform android",
    "eas:preview": "eas build --profile preview --platform android",
    "eas:production": "eas build --profile production --platform android",
    "eas:development-local": "dotenv -e .env -- eas build --profile development --platform android --local",
    "eas:preview-local": "dotenv -e .env -- eas build --profile preview --platform android --local",
    "eas:production-local": "dotenv -e .env -- eas build --profile production --platform android --local",
    "eas:submit": "dotenv -e .env -- eas submit --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@microsoft/react-native-clarity": "^4.6.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "5.90.20",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.18",
    "expo-linking": "~56.0.14",
    "expo-media-library": "~56.0.7",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.5",
    "i18n-js": "^4.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.2",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
