# Base URL of the educado-api.
# Required: the app throws at boot if it is not set (utils/api-config.ts).
#
# Default below points at a local API, so a fresh checkout never talks to
# production by accident. Change it deliberately when you mean to.
EXPO_PUBLIC_API_URL=http://localhost:5001
#
# Local development against an API running on your own machine:
#   iOS simulator / web (host localhost): http://localhost:5001
#   Android emulator (host localhost):    http://10.0.2.2:5001
#   Physical device on the same LAN:      http://192.168.x.y:5001
#
# Production (set it in the build environment, not in a local .env):
#   https://api-educado.tominho.com
#
# Note: https://igg084s4s08sk0w08gsc0cgk.tominho.com was an auto generated
# Coolify hostname. It no longer exists and answers 503. Do not use it.
